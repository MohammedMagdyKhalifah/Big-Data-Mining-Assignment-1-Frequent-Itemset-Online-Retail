  "cleaning_steps": [
    {
      "Step": "1. Remove exact duplicate rows",
      "Rows Before": 541909,
      "Rows Removed": 5268,
      "Values Changed": 0,
      "Rows After": 536641,
      "Reason": "Identical invoice lines (all 8 fields equal) are data-entry duplicates and add no new purchase."
    },
    {
      "Step": "2. Remove cancelled invoices (InvoiceNo starts with 'C')",
      "Rows Before": 536641,
      "Rows Removed": 9251,
      "Values Changed": 0,
      "Rows After": 527390,
      "Reason": "Cancellations/returns are not purchases; the products were not bought together."
    },
    {
      "Step": "3. Remove non-standard invoice numbers (e.g. 'A563185')",
      "Rows Before": 527390,
      "Rows Removed": 3,
      "Values Changed": 0,
      "Rows After": 527387,
      "Reason": "'A' invoices are accounting adjustments ('Adjust bad debt'), not customer orders."
    },
    {
      "Step": "4. Remove rows with missing product description",
      "Rows Before": 527387,
      "Rows Removed": 1454,
      "Values Changed": 0,
      "Rows After": 525933,
      "Reason": "Without a description the item cannot be identified or interpreted."
    },
    {
      "Step": "5. Remove rows with Quantity <= 0",
      "Rows Before": 525933,
      "Rows Removed": 474,
      "Values Changed": 0,
      "Rows After": 525459,
      "Reason": "Zero/negative quantities are stock corrections (e.g. 'damaged', 'lost'), not sales."
    },
    {
      "Step": "6. Remove rows with UnitPrice <= 0",
      "Rows Before": 525459,
      "Rows Removed": 582,
      "Values Changed": 0,
      "Rows After": 524877,
      "Reason": "Free or negative-price lines are internal adjustments rather than customer purchases."
    },
    {
      "Step": "7. Remove non-product stock codes (POSTAGE, CARRIAGE, fees, vouchers, ...)",
      "Rows Before": 524877,
      "Rows Removed": 2337,
      "Values Changed": 0,
      "Rows After": 522540,
      "Reason": "Postage and fees appear in many baskets for administrative reasons and would create meaningless rules such as {X} -> {POSTAGE}."
    },
    {
      "Step": "8. Standardise descriptions (trim, collapse spaces, upper-case)",
      "Rows Before": 522540,
      "Rows Removed": 0,
      "Values Changed": 126548,
      "Rows After": 522540,
      "Reason": "Leading/trailing/double spaces and mixed case make the same product look like different items."
    },
    {
      "Step": "9. Map each StockCode to one canonical description",
      "Rows Before": 522540,
      "Rows Removed": 0,
      "Values Changed": 6555,
      "Rows After": 522540,
      "Reason": "Some stock codes have several spellings; the most frequent one is used as the item name."
    },
    {
      "Step": "10. Appropriateness (Halaal) filter on descriptions",
      "Rows Before": 522540,
      "Rows Removed": 3442,
      "Values Changed": 0,
      "Rows After": 519098,
      "Reason": "Whole-word keywords WINE, GIN, CHAMPAGNE, COCKTAIL, BOOZE, ASHTRAY, CIGAR, SPLIFF (alcohol- or smoking-themed items) are excluded; the affected products are listed in excluded_products.csv."
    },
    {
      "Step": "11. Collapse repeated items within the same invoice",
      "Rows Before": 519098,
      "Rows Removed": 5535,
      "Values Changed": 0,
      "Rows After": 513563,
      "Reason": "A basket is a set: buying the same product on two lines is still one item."
    }
  ],
